{# @var plugin \bensomething\craftdub\Plugin #}
{# @var settings \bensomething\craftdub\models\Settings #}
{% requireAdmin false %}

{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}

{% set title = plugin.name %}
{% set docTitle = title ~ ' - ' ~ 'Plugins' | t('app') %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: 'Settings' | t('app'), url: url('settings') },
    { label: 'Plugins' | t('app'), url: url('settings/plugins') },
] %}

{% set formActions = [{
    label: 'Save and continue editing' | t('app'),
    redirect: "settings/plugins/#{plugin.handle}" | hash,
    shortcut: true,
    retainScroll: true,
}] %}

{% set selectedTab = 'dub-general' %}
{% set tabs = {
    'dub-general': { label: 'General' | t('dub'), url: '#dub-general' },
    'dub-sidebar': { label: 'Sidebar' | t('dub'), url: '#dub-sidebar' },
} %}

{% block content %}
    {{ actionInput('plugins/save-plugin-settings') }}
    {{ hiddenInput('pluginHandle', plugin.handle) }}
    {{ redirectInput('settings') }}

    {# Full-bleed dividers, matching Craft's native `.content-pane > hr` (our hrs are nested a level deeper). #}
    <style>#dub-general hr, #dub-sidebar hr { margin-inline: calc(var(--padding) * -1); }</style>

    <div id="dub-general" role="tabpanel" aria-labelledby="tab-dub-general">
        {% namespace 'settings' %}
            <style>#settings-apiKey-field { margin-top: 0; }</style>
            {{ forms.autosuggestField({
                label: 'API Key' | t('dub'),
                id: 'apiKey',
                name: 'apiKey',
                value: settings.apiKey,
                suggestEnvVars: true,
                required: true,
                errors: settings.getErrors('apiKey'),
                instructions: 'Enter your Dub API key. <a class="go" href="https://dub.co/docs/api-reference/authentication#api-keys" target="_blank" rel="noopener">Learn more</a>' | t('dub'),
            }) }}

            {% set domainData = [] %}
            {% for domain in domains ?? [] %}
                {% set domainData = domainData | merge([{ name: domain.slug }]) %}
            {% endfor %}
            {{ forms.autosuggestField({
                label: 'Domain' | t('dub'),
                id: 'domain',
                name: 'domain',
                value: settings.domain,
                suggestions: domainData ? [{ label: 'Domains' | t('dub'), data: domainData }] : [],
                suggestEnvVars: true,
                errors: settings.getErrors('domain'),
                instructions: 'Select the short link domain to use, or set it from an environment variable. Available domains load after saving your API key.' | t('dub'),
                warning: allSitesOverridden
                    ? 'Every site has its own domain below, so this one is not used.' | t('dub')
                    : domainWarning,
            }) }}

            {% if showSiteDomains %}
                {# Craft's own table chrome, but the domain cell is rendered here rather than by
                   the table's autosuggest type. That type forwards only suggestEnvVars and
                   suggestAliases, so it cannot offer the workspace's own domains. An `html`
                   column emits its cell value raw, so a real autosuggest can be rendered into
                   it with the same suggestions as the field above. It posts under its own name,
                   so the value still comes back on save. #}
                {% set domainRows = {} %}
                {% for site in sites %}
                    {% set cell %}
                        {% include '_includes/forms/autosuggest' with {
                            id: 'siteDomains-' ~ site.uid,
                            name: 'siteDomains[' ~ site.uid ~ ']',
                            value: siteDomains[site.uid] ?? '',
                            placeholder: defaultDomain,
                            suggestions: domainData ? [{ label: 'Domains' | t('dub'), data: domainData }] : [],
                            suggestEnvVars: true,
                        } only %}
                    {% endset %}
                    {% set domainRows = domainRows | merge({
                        (site.uid): { site: site.name, domain: cell },
                    }) %}
                {% endfor %}

                {# Craft's own text cells are borderless textareas filling the cell, so a td
                   carries the padding. An autosuggest brings its own bordered input, which
                   doubles it up. Strip the cell padding and let the input sit flush. #}
                <style>
                    .dub-site-domains table.editable td { padding: 0; }
                    .dub-site-domains table.editable td .autosuggest-container .text {
                        border: 0;
                        border-radius: 0;
                        box-shadow: none;
                        background: transparent;
                    }
                </style>

                <div class="dub-site-domains">
                {# The tip sits on the table rather than on each row. The per-site inputs are
                   raw autosuggest includes, so they support environment variables without the
                   tip the field wrapper adds, and repeating it per row would print it once per
                   site. #}
                {{ forms.editableTableField({
                    label: 'Domains per site' | t('dub'),
                    instructions: 'Leave a site blank to use the domain above.' | t('dub'),
                    tip: 'These can begin with an environment variable.' | t('dub'),
                    warning: siteDomainWarning,
                    id: 'siteDomains',
                    name: 'siteDomains',
                    cols: {
                        site: { heading: 'Site' | t('dub'), type: 'heading', width: 150 },
                        domain: { heading: 'Domain' | t('dub'), type: 'html', width: '100%' },
                    },
                    rows: domainRows,
                    allowAdd: false,
                    allowDelete: false,
                    allowReorder: false,
                    errors: settings.getErrors('siteDomains'),
                }) }}
                </div>
            {% endif %}

            {% if sectionOptions %}
            <hr>
            {{ forms.checkboxSelectField({
                label: 'Sections' | t('dub'),
                id: 'sections',
                name: 'sections',
                options: sectionOptions,
                values: '*' in enabledSections ? '*' : enabledSections,
                showAllOption: true,
                disabled: sectionsOverridden,
                instructions: 'Select which sections to enable short links for.' | t('dub'),
                warning: sectionsOverridden ? 'This is being overridden by the `DUB_SECTIONS` environment variable.' | t('dub') : null,
            }) }}
            {% endif %}

            <hr>
            <div class="field">
                <div class="heading">
                    <label>{{ 'Connection' | t('dub') }}</label>
                    <div class="instructions">
                        <p>{{ 'Creates a short link, reads it, and then deletes it.' | t('dub') }}</p>
                    </div>
                </div>
                <div class="input">
                    {{ forms.button({
                        label: 'Test' | t('dub'),
                        spinner: true,
                        attributes: { data: { 'dub-test': true } },
                    }) }}
                    <div data-dub-test-results class="dub-test-results" role="status"></div>
                </div>
            </div>
        {% endnamespace %}
    </div>

    <div id="dub-sidebar" class="hidden" role="tabpanel" aria-labelledby="tab-dub-sidebar">
        {% namespace 'settings' %}
            {{ forms.lightswitchField({
                label: 'Show click count' | t('dub'),
                id: 'showClicks',
                name: 'showClicks',
                on: settings.showClicks,
                errors: settings.getErrors('showClicks'),
                instructions: 'Display a read-only click count in the entry sidebar.' | t('dub'),
            }) }}

            <hr>
            {{ forms.selectField({
                label: 'QR code display' | t('dub'),
                id: 'qrViewMode',
                name: 'qrViewMode',
                value: settings.qrViewMode,
                options: [
                    { label: 'None' | t('dub'), value: 'none' },
                    { label: 'Icon' | t('dub'), value: 'icon' },
                    { label: 'Full' | t('dub'), value: 'full' },
                ],
                errors: settings.getErrors('qrViewMode'),
                instructions: 'How the QR code appears in the entry sidebar. <strong>None</strong> hides it, <strong>Icon</strong> adds a small QR icon to the link row, and <strong>Full</strong> shows the QR image.' | t('dub'),
            }) }}

            {{ forms.editableTableField({
                label: 'QR code style' | t('dub'),
                instructions: 'Styling applied to QR codes shown in the sidebar and output by `dubQr()`.' | t('dub'),
                id: 'qrStyle',
                name: 'qrStyle',
                cols: {
                    size: { heading: 'Size' | t('dub'), type: 'number', width: 70, info: 'Minimum `600`. Defaults to `1200` if blank.' | t('dub') },
                    margin: { heading: 'Margin' | t('dub'), type: 'number', width: 70, info: 'Maximum `20`. Defaults to `2` if blank.' | t('dub') },
                    foreground: { heading: 'Foreground' | t('dub'), type: 'color', width: 120, info: 'Defaults to `#000000` if blank.' | t('dub') },
                    background: { heading: 'Background' | t('dub'), type: 'color', width: '100%', info: 'Defaults to `#ffffff` if blank.' | t('dub') },
                },
                rows: settings.qrStyle,
                minRows: 1,
                maxRows: 1,
                allowAdd: false,
                allowDelete: false,
                allowReorder: false,
                errors: settings.getErrors('qrStyle'),
            }) }}
        {% endnamespace %}
    </div>

    {% js %}
        (() => {
            const button = document.querySelector('[data-dub-test]');
            const results = document.querySelector('[data-dub-test-results]');

            if (!button || !results) {
                console.warn('Dub: test button not found');
                return;
            }

            button.addEventListener('click', async () => {
                button.classList.add('loading');
                button.disabled = true;
                results.innerHTML = '';

                try {
                    const {data} = await Craft.sendActionRequest('POST', 'dub/test/run');

                    // Craft's own static table chrome, so it reads as part of the settings
                    // screen rather than as a list bolted underneath it.
                    const rows = data.steps.map((step) => {
                        // The mark is hidden from screen readers and the state is given as
                        // words instead, since a red tick and a green tick are the same tick to
                        // anyone who cannot tell them apart.
                        const mark = step.ok ? '✓' : '✗';
                        const state = step.ok ? Craft.t('dub', 'Passed') : Craft.t('dub', 'Failed');
                        const cls = step.ok ? 'dub-test-ok' : 'dub-test-fail';

                        return `<tr class="${cls}">
                            <td class="dub-test-mark">
                                <span aria-hidden="true">${mark}</span>
                                <span class="visually-hidden">${state}</span>
                            </td>
                            <th scope="row">${Craft.escapeHtml(step.step)}</th>
                            <td class="dub-test-detail">${Craft.escapeHtml(step.detail)}</td>
                        </tr>`;
                    }).join('');

                    results.innerHTML = `<table class="editable fullwidth dub-test-table">
                        <tbody>${rows}</tbody>
                    </table>`;
                } catch (e) {
                    results.innerHTML = `<p class="error">${Craft.escapeHtml(
                        e?.response?.data?.message ?? Craft.t('dub', 'The test could not be run.')
                    )}</p>`;
                } finally {
                    button.classList.remove('loading');
                    button.disabled = false;
                }
            });
        })();
    {% endjs %}

    {% css %}
        .dub-test-results { margin-block-start: var(--s); }

        /* The mark and the label take only what they need, so the detail column absorbs the
           rest and every result starts at the same x position. */
        table.dub-test-table tbody th[scope="row"] { white-space: nowrap; width: 1%; }

        /* A real width rather than shrink-to-fit, or there is nothing for the mark to be
           centred within. */
        table.dub-test-table tbody td.dub-test-mark { width: 2.5rem; }
        table.dub-test-table tbody td.dub-test-detail { width: 100%; }

        /* Craft sets these cells to var(--input-bg), which is not a defined token, so they
           come out transparent. State it. */
        /* Craft gives td 4px block padding with vertical-align top, and th 6px, so the label
           sits on a different baseline to the cells either side of it. One value for all
           three, aligned centre so the mark lines up with its text.

           Every selector here carries the element names as well as the class. Craft's are
           `table.editable tbody tr td`, one class and three elements, which outranks a bare
           class however many words it has. */
        table.dub-test-table tbody tr td,
        table.dub-test-table tbody tr th {
            background-color: var(--white);
            padding-block: 6px;
            vertical-align: middle;
        }

        table.dub-test-table tbody td.dub-test-mark {
            border-inline-end: 1px solid var(--border-hairline);
            text-align: center;
            font-weight: var(--font-weight-bold);
        }

        /* --enabled-color rather than --success-color: the latter is teal-700, dark enough to
           read as grey at this size, while this is the green of a lightswitch that is on.
           Element and class together, so Craft's own cell selectors cannot outrank these. */
        table.dub-test-table tbody tr.dub-test-ok td.dub-test-mark { color: var(--enabled-color); }
        table.dub-test-table tbody tr.dub-test-fail td.dub-test-mark { color: var(--error-color); }
    {% endcss %}
{% endblock %}
