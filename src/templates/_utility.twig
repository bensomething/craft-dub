{# @var hasApiKey bool #}
{# @var settingsUrl string #}
{# @var canRepair bool #}
{# @var showSite bool #}
{# @var linkCount int #}

{% if not hasApiKey %}
    {# The field's name is passed in rather than bolded around a split string, so a translator
       still gets a whole sentence to work with. #}
    <p>{{ 'Add your Dub {label} before checking links.' | t('dub', {
            label: '<strong>' ~ ('API Key' | t('dub')) ~ '</strong>',
        }) | raw }}
        <a href="{{ settingsUrl }}">{{ "Go to the plugin's settings." | t('dub') }}</a></p>
{% else %}
    <p><strong>{{ 'Check links' | t('dub') }}</strong>
        {{ 'runs every short link recorded here against Dub, and reports:' | t('dub') }}</p>

    <ul class="bullets">
        <li>{{ 'links that are missing' | t('dub') }}</li>
        <li>{{ 'links that have been edited at Dub' | t('dub') }}</li>
        <li>{{ 'links that no longer point where their entry lives' | t('dub') }}</li>
    </ul>

    {% if canRepair %}
        <p><strong>{{ 'Repair links' | t('dub') }}</strong>
            {{ 'recreates the missing links and reconciles the edited ones.' | t('dub') }}</p>

        {# The label stays outside the translated string, so a translator gets a sentence to
           work with rather than a sentence with markup wrapped around part of it. #}
        <ul class="bullets">
            <li><strong>{{ 'Destination URL' | t('dub') }}:</strong>
                {{ 'Craft owns this, so its value is pushed back to Dub.' | t('dub') }}</li>
            <li><strong>{{ 'Short link slug' | t('dub') }}:</strong>
                {{ 'Dub owns this, so a rename made there is adopted here rather than reversed.' | t('dub') }}</li>
        </ul>
    {% endif %}

    {# Full bleed on its own. The utility's content is rendered straight into the content
       pane, so this is a real `.content-pane > hr` and Craft's own negative inline margin
       applies. The settings screen has to restate that rule because its hrs sit a level
       deeper, inside a tab panel. #}
    <hr>

    {# Craft's own `.buttons` margin is the gap before the results, and dead space at the foot
       of the pane when there are none. So it is kept, and dropped only while there is nothing
       under it, by a class the script puts on and takes off.

       Both CSS-only versions of this failed, and for the same underlying reason: each asked a
       selector to react to content injected by script. `:has(+ #dub-check-results:empty)` left
       the collapsed margin applied after the container filled, and moving the gap onto
       `#dub-check-results > :first-child` never landed on the injected first child at all. A
       class on the element whose margin is in question has nothing to get wrong. #}
    <style>.dub-buttons.dub-no-results { margin-block-end: 0 }</style>

    <div class="buttons dub-buttons dub-no-results">
        {# Two buttons rather than a switch beside one: repairing writes to Dub, and an action
           that reaches a third party should say so on the control that starts it. #}
        <button type="button" class="btn submit dub-check-btn" data-fix="0">{{ 'Check links' | t('dub') }}</button>
        {% if canRepair %}
            <button type="button" class="btn dub-check-btn" data-fix="1">{{ 'Repair links' | t('dub') }}</button>
        {% endif %}
    </div>

    <div id="dub-check-results">
        {# Craft.ProgressBar fills this, and with steps on it prints the running count under
           the bar, the way the Asset Indexes utility does. #}
        <div id="dub-check-progress" class="hidden"></div>

        {# Opened empty and filled a slice at a time, so findings from the slices that did land
           stay on screen if a later one fails. #}
        <table id="dub-check-table" class="data fullwidth hidden">
            <thead>
                <tr>
                    <th scope="col">{{ 'Status' | t('dub') }}</th>
                    <th scope="col">{{ 'Entry' | t('dub') }}</th>
                    {% if showSite %}<th scope="col">{{ 'Site' | t('dub') }}</th>{% endif %}
                    <th scope="col">{{ 'Short link' | t('dub') }}</th>
                    <th scope="col">{{ 'Detail' | t('dub') }}</th>
                </tr>
            </thead>
            <tbody id="dub-check-rows"></tbody>
        </table>

        <div id="dub-check-summary"></div>
    </div>

    {% js %}
        (function() {
            var $buttons = $('.dub-check-btn');
            var $buttonRow = $('.dub-buttons');
            var $progress = $('#dub-check-progress');
            var $table = $('#dub-check-table');
            var $rows = $('#dub-check-rows');
            var $summary = $('#dub-check-summary');

            var confirmRepair = {{ 'Recreate deleted links and re-point edited ones to match Craft?' | t('dub') | json_encode | raw }};
            var failed = {{ 'The check could not be run.' | t('dub') | json_encode | raw }};
            var linkCount = {{ linkCount }};

            {# Second argument is displaySteps, which is what prints "6 / 10" beneath the bar. #}
            var progressBar = new Craft.ProgressBar($progress, true);

            {# hideProgressBar() also stops the interval that announces progress to screen
               readers, so the bar is never just hidden. #}
            function stopProgress() {
                progressBar.hideProgressBar();
                $progress.addClass('hidden');
            }

            {# The buttons keep their bottom margin only while something sits under them. #}
            function syncSpacing() {
                var hasContent = $rows.children().length > 0
                    || $.trim($summary.html()).length > 0
                    || !$progress.hasClass('hidden');

                $buttonRow.toggleClass('dub-no-results', !hasContent);
            }

            function runSlice(fix, offset, totals) {
                var data = { fix: fix ? 1 : 0, offset: offset };
                if (totals) {
                    data.totals = totals;
                }

                return Craft.sendActionRequest('POST', 'dub/check/run', { data: data })
                    .then(function(response) {
                        var result = response.data;

                        $rows.append(result.rowsHtml);
                        if ($rows.children().length) {
                            $table.removeClass('hidden');
                        }

                        {# Re-read from the response rather than trusted from the start: a save
                           during a long run can add a link, and a denominator that never moves
                           would quietly finish at 41 of 40. #}
                        progressBar.setItemCount(result.total);
                        progressBar.setProcessedItemCount(result.checked);
                        progressBar.updateProgressBar();
                        syncSpacing();

                        if (result.done) {
                            $summary.html(result.summaryHtml);
                            stopProgress();
                            syncSpacing();
                            return;
                        }

                        return runSlice(fix, result.nextOffset, result.totals);
                    });
            }

            $buttons.on('click', function(ev) {
                ev.preventDefault();

                var fix = $(this).data('fix') === 1;
                if (fix && !confirm(confirmRepair)) {
                    return;
                }

                $buttons.addClass('disabled').attr('disabled', true);
                $rows.empty();
                $summary.empty();
                $table.addClass('hidden');

                {# resetProgressBar() puts the count back to 1 of 0, so the real total goes on
                   after it, not before. Zero processed keeps the bar striped rather than empty,
                   which is the right look for work that has started and reported nothing yet. #}
                progressBar.resetProgressBar();
                progressBar.setItemCount(linkCount);
                progressBar.setProcessedItemCount(0);
                progressBar.updateProgressBar();
                progressBar.showProgressBar();
                $progress.removeClass('hidden');
                syncSpacing();

                runSlice(fix, 0, null)
                    .catch(function(e) {
                        {# Whatever landed before the failure stays on screen. That is the whole
                           point of slicing: a run that stops halfway says where it got to. #}
                        Craft.cp.displayError((e && e.response && e.response.data && e.response.data.message) || failed);
                        stopProgress();
                        syncSpacing();
                    })
                    .then(function() {
                        $buttons.removeClass('disabled').attr('disabled', false);
                    });
            });
        })();
    {% endjs %}
{% endif %}
