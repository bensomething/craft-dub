{# @var summary array #}
{# @var fix bool #}
{# @var canRepair bool #}
{# @var settingsUrl string #}

{# Rendered once, when the last slice lands, from the totals carried across the whole run. #}

{# Derived rather than passed: the rows are spread across every slice of the run, so by the
   time this renders there is no list left to ask how long it was. Only these four statuses
   open a row, and a repair folds into the row that found it. #}
{% set findings = summary.missing + summary.drifted + summary.stale + summary.unreadable %}

{# What can actually be done about what was found. Every line is conditional, and there are
   still runs where none of them hold: a user without the repair permission is not going to be
   told to press a button they cannot see, and a repair that fixed everything leaves nothing to
   say. So the heading hangs off this rather than off there being findings at all. #}
{% set offerRepair = not fix and canRepair and (summary.missing or summary.drifted) %}
{% set showFix = offerRepair or summary.unrepaired or summary.stale or summary.unreadable %}

{% if summary.error %}
    <p class="error">{{ summary.error }}</p>
{% elseif summary.checked == 0 %}
    <p>{{ 'No short links have been recorded yet.' | t('dub') }}</p>
{% elseif findings == 0 %}
    {# One line, no table above it and nothing to fix below it. A heading over a lone sentence
       labels a section that isn't there. #}
    <p>{{ '{checked} links checked. Nothing to report.' | t('dub', { checked: summary.checked }) }}</p>
{% else %}
    <hr>

    <h3>{{ 'Result' | t('dub') }}</h3>

    {# Detections first, then what was done about them, so a row that drifted and could not be
       repaired appears once on each side rather than twice in one count. #}
    <p>{{ '{checked} checked: {ok} ok, {missing} missing, {drifted} drifted, {stale} stale, {unreadable} unreadable.' | t('dub', {
        checked: summary.checked,
        ok: summary.ok,
        missing: summary.missing,
        drifted: summary.drifted,
        stale: summary.stale,
        unreadable: summary.unreadable,
    }) }}</p>

    {% if fix %}
        <p>{{ '{repaired} repaired, {unrepaired} could not be repaired.' | t('dub', {
            repaired: summary.repaired,
            unrepaired: summary.unrepaired,
        }) }}</p>
    {% endif %}

    {% if showFix %}
        <h3>{{ 'How to fix' | t('dub') }}</h3>

        {% if offerRepair %}
            {# The button's name is passed in rather than bolded around a split string, so a
               translator still gets a whole sentence to work with. #}
            <p>{{ 'Use {button} to recreate the missing links and reconcile the drifted ones.' | t('dub', {
                button: '<strong>' ~ ('Repair links' | t('dub')) ~ '</strong>',
            }) | raw }}</p>
        {% endif %}

        {% if summary.unrepaired %}
            {# The reason sits in the row, since it is per link and often different each time.
               What belongs here is only what to do once it has been read. #}
            <p>{{ 'Repairs that did not take give their reason above. Put that right at Dub, then run {button} again.' | t('dub', {
                button: '<strong>' ~ ('Repair links' | t('dub')) ~ '</strong>',
            }) | raw }}</p>
        {% endif %}

        {% if summary.stale %}
            {# Not repaired here on purpose: a link only moves when its entry is saved, and
               reimplementing that move would be a second place deciding what a link looks like. #}
            {# The command is passed in rather than left in the string: it is a literal, not
               something to translate, and the full stop stays outside the code element. #}
            <p>{{ 'Stale links move when their entries are next saved. Save the entries listed above, or run {command}.' | t('dub', {
                command: '<code>php craft resave/entries</code>',
            }) | raw }}</p>
        {% endif %}

        {% if summary.unreadable %}
            {# Unreadable is the API failing rather than anything being wrong with the link, so
               the remedy is about the connection, not the entry. #}
            <p>{{ 'Links that could not be read give their reason above. Run the connection test on the {link} to check the API key and the workspace.' | t('dub', {
                link: '<a href="' ~ settingsUrl ~ '">' ~ ('settings screen' | t('dub')) ~ '</a>',
            }) | raw }}</p>
        {% endif %}
    {% endif %}
{% endif %}
